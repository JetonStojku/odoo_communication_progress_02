<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_form_view" model="ir.ui.view">
            <field name="name">selling_store.product.form</field>
            <field name="model">selling_store.product</field>
            <field name="arch" type="xml">
                <form string="Product">
                    <sheet>
                        <div class="oe_title">
                            <label for="product"/>
                            <h1>
                                <field name="product" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="get_points"/>
                                <field name="category_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="buy_price"/>
                                <field name="sell_price"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_tree_view" model="ir.ui.view">
            <field name="name">selling_store.product.tree</field>
            <field name="model">selling_store.product</field>
            <field name="arch" type="xml">
                <tree string="Product">
                    <field name="product"/>
                    <field name="quantity"/>
                    <field name="sell_price"/>
                </tree>
            </field>
        </record>

        <record id="product_search_view" model="ir.ui.view">
            <field name="name">selling_store.product.search</field>
            <field name="model">selling_store.product</field>
            <field name="arch" type="xml">
                <search string="Product">
                    <field name="product"/>
                    <field name="quantity"/>
                    <field name="sell_price"/>
                </search>
            </field>
        </record>

        <record id="product_act_window" model="ir.actions.act_window">
            <field name="name">Product</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">selling_store.product</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Product.
                </p>
            </field>
        </record>

    </data>
</odoo>