<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="invoice_form_view" model="ir.ui.view">
            <field name="name">selling_store.invoice.form</field>
            <field name="model">selling_store.invoice</field>
            <field name="arch" type="xml">
                <form string="Invoice">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1>
                                <field name="code" placeholder="Code"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="client_id"/>
                                <field name="invoice_date"/>
                            </group>
                            <group>
                                <field name="total"/>
                                <field name="state"/>
                                <field name="type"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="invoice_line" string="Invoice Line">
                                <field name="invoice_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="invoice_tree_view" model="ir.ui.view">
            <field name="name">selling_store.invoice.tree</field>
            <field name="model">selling_store.invoice</field>
            <field name="arch" type="xml">
                <tree string="Invoice">
                    <field name="code"/>
                    <field name="employee_id"/>
                    <field name="client_id"/>
                    <field name="total"/>
                </tree>
            </field>
        </record>

        <record id="invoice_search_view" model="ir.ui.view">
            <field name="name">selling_store.invoice.search</field>
            <field name="model">selling_store.invoice</field>
            <field name="arch" type="xml">
                <search string="Invoice">
                    <field name="code"/>
                    <field name="employee_id"/>
                    <field name="client_id"/>
                    <field name="total"/>
                </search>
            </field>
        </record>

        <record id="invoice_act_window" model="ir.actions.act_window">
            <field name="name">Invoice</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">selling_store.invoice</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Invoice.
                </p>
            </field>
        </record>

    </data>
</odoo>