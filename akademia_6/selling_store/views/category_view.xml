<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="category_tree_view" model="ir.ui.view">
            <field name="name">selling_store.category.tree</field>
            <field name="model">selling_store.category</field>
            <field name="arch" type="xml">
                <tree string="Category">
                    <field name="name"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="category_search_view" model="ir.ui.view">
            <field name="name">selling_store.category.search</field>
            <field name="model">selling_store.category</field>
            <field name="arch" type="xml">
                <search string="Category">
                    <field name="name"/>
                    <field name="description"/>
                </search>
            </field>
        </record>

        <record id="category_act_window" model="ir.actions.act_window">
            <field name="name">Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">selling_store.category</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Category.
                </p>
            </field>
        </record>

        <menuitem name="Category" id="category_menu" parent="store_root" action="category_act_window"/>

    </data>
</odoo>